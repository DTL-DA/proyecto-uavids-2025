# Solo se versionan los entregables
/*
!/.gitignore
!/README.md
!/requirements.txt
!/Entregable 1 - UAVIDS-2025.ipynb
!/Entregable 2 - UAVIDS-2025.ipynb
!/Entregable_1_UAVIDS_2025/
!/Entregable_2_UAVIDS_2025/

# Del Entregable 1 se hereda la partición y su declaración; el CSV se descarga o se regenera al ejecutar el cuaderno
/Entregable_1_UAVIDS_2025/datos/
/Entregable_1_UAVIDS_2025/resultados/datos_preparados.npz
/Entregable_1_UAVIDS_2025/resultados/resultados_listos.txt

# Texto de terceros: los scripts de búsqueda vuelven a consultar las fuentes
/Entregable_1_UAVIDS_2025/literatura/exportaciones/*
!/Entregable_1_UAVIDS_2025/literatura/exportaciones/2026-11-03_resumen.json
/Entregable_2_UAVIDS_2025/literatura/exportaciones/*
!/Entregable_2_UAVIDS_2025/literatura/exportaciones/*_resumen_e2.json
!/Entregable_2_UAVIDS_2025/literatura/exportaciones/*_conteos_scopus_wos_e2.json

# Pesos y probabilidades por corrida: se empaquetan aparte
/Entregable_2_UAVIDS_2025/resultados/corridas/**/*.pt
/Entregable_2_UAVIDS_2025/resultados/corridas/**/*.npy
/Entregable_2_UAVIDS_2025/resultados/corridas/**/*.tmp
/Entregable_2_UAVIDS_2025/resultados/corridas/**/*.pkl

__pycache__/
*.py[cod]
.ipynb_checkpoints/
_build/
*.log

# El PDF del informe del Entregable 2 se regenera con organizar_entregables.py y viaja en el ZIP del correo
/Entregable_2_UAVIDS_2025/entregables/01_informe_jupyter_book/Informe_Entregable_2.pdf

# Material de preparación de la presentación oral: se queda en local
/Entregable_2_UAVIDS_2025/defensa/
/Entregable_2_UAVIDS_2025/herramientas/crear_guion_defensa.py

# Entregable 3: se versiona la carpeta; los datos crudos de los conjuntos adicionales no (ver data/procedencia_conjuntos_adicionales.md)
!/Entregable_3_UAVIDS_2025/
/Entregable_3_UAVIDS_2025/data/raw/
/Entregable_3_UAVIDS_2025/experiments/diseno/corridas/
/Entregable_3_UAVIDS_2025/book/_build/
/Entregable_3_UAVIDS_2025/experiments/**/*.npy
/Entregable_3_UAVIDS_2025/experiments/**/*.pt
/Entregable_3_UAVIDS_2025/experiments/**/*.tmp

# Integración continua del Entregable 3
!/.github/
/Entregable_3_UAVIDS_2025/experiments/novedad/exportaciones/*
!/Entregable_3_UAVIDS_2025/experiments/novedad/exportaciones/*_resumen_novedad.json
